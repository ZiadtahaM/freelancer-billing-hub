# ────────────────────────────────────────────
# MenuStack Environment Variables
# Copy this file to .env and fill in your values
# ────────────────────────────────────────────

# PostgreSQL connection (required)
DATABASE_URL=postgresql://menustack:password@localhost:5432/menustack

# Session secret — generate with: openssl rand -hex 32
SESSION_SECRET=change_me_to_a_long_random_string_at_least_32_chars

# CORS — comma-separated list of allowed origins
# In production, set this to your actual domain(s)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:25130

# API server port (default: 8080)
PORT=8080

# Set to "production" for production deployments
NODE_ENV=development

# Docker Compose only
POSTGRES_PASSWORD=menustack_dev
